# Copia este archivo a .env.local y pon aquí tu cadena de conexión real
# de Aiven (la misma que usa el sistema principal de ENVIOS AYORA, porque
# este sitio lee de la misma base de datos, solo que no puede escribir
# ni borrar nada, solo consulta).
DATABASE_URL=postgres://usuario:password@host:puerto/basedatos?sslmode=require
